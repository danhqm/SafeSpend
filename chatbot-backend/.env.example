SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_key
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
OPENAI_API_KEY=your_openai_api_key
OWNER_USER_ID=your_supabase_auth_user_uuid
# Only needed for a browser client. Native Expo requests do not send an Origin header.
ALLOWED_ORIGIN=https://your-web-app.example.com
# Optional model overrides
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
# Optional per-user API quotas (defaults shown)
CHAT_BURST_LIMIT=10
CHAT_BURST_WINDOW_SECONDS=60
CHAT_DAILY_LIMIT=100
OCR_BURST_LIMIT=5
OCR_BURST_WINDOW_SECONDS=600
OCR_DAILY_LIMIT=20
FIN_INSIGHTS_BURST_LIMIT=10
FIN_INSIGHTS_BURST_WINDOW_SECONDS=3600
FIN_INSIGHTS_DAILY_LIMIT=30
